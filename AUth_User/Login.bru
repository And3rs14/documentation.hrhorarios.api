meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/login
  body: json
  auth: none
}

body:json {
  // {
  //   "dni": "12345678",
  //   "password": "password"
  // }
  
  {
    "dni": "87654321",
    "password": "password"
  }
  
  // {
  //   "dni": "89652365",
  //   "password": "secret123"
  // }
  
}

vars:post-response {
  access_token: res.body.data.token
}
